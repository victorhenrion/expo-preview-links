{
  "name": "expo-preview-links",
  "version": "0.1.0",
  "private": true,
  "description": "Stable per-branch permalinks to the latest Expo (EAS) iOS and Android builds, posted on every pull request.",
  "license": "MIT",
  "author": "victorhenrion",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^2.0.0",
    "@actions/github": "^9.1.1",
    "@juit/qrcode": "^1.0.111",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@cloudflare/vitest-plugin": "^1.1.9",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/node": "^24.9.2",
    "rollup": "^4.57.1",
    "tslib": "^2.8.1",
    "typescript": "5.9.3",
    "vitest": "~4.1.0",
    "wrangler": "^4.131.2"
  }
}
